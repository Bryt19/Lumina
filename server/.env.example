# Google AI Studio / Gemini API key. NEVER commit the real value.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-key

# Optional: override the model. Free-tier quota is per model (~20 req/day), so
# if you hit 429 quota errors on the default, switch to another available model
# (see https://ai.google.dev/gemini-api/docs/models) or add billing.
# Verified working models: gemini-3.5-flash (default) and gemini-3-flash-preview.
GEMINI_MODEL=gemini-3-flash-preview

# Optional: override the port (defaults to 3000)
# PORT=3000

# Optional: SQLite database path (defaults to ./data.db next to db.js)
# DB_PATH=./data.db

# OpenRouter API key (second provider). Used when Gemini is out of quota/rate-limited.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Optional: OpenRouter model (defaults to openai/gpt-4o)
OPENROUTER_MODEL=openai/gpt-4o

# Optional: attribution shown to OpenRouter (site URL / name)
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_SITE_NAME=Lumina Support

# Optional: max tokens per reply (defaults to 1024). Lower it if OpenRouter
# rejects requests with a 402 "requires more credits, or fewer max_tokens" error.
# OPENROUTER_MAX_TOKENS=1024

# BazaarLink API key (third provider, after Gemini and OpenRouter). OpenAI-compatible gateway.
# Get one at https://bazaarlink.ai
BAZAARLINK_API_KEY=replace-with-your-bazaarlink-key

# Optional: BazaarLink model (defaults to openai/gpt-4o)
BAZAARLINK_MODEL=openai/gpt-4o

# Optional: max tokens per reply (defaults to 1024)
# BAZAARLINK_MAX_TOKENS=1024

# Optional: attribution shown to BazaarLink (site URL / name)
# BAZAARLINK_SITE_URL=https://example.com
# BAZAARLINK_SITE_NAME=Lumina Support
